# Copy to .env and adjust if you change docker-compose.yml.
# These are local-only dev credentials for the PostGIS container. Not secrets.
IAN_DATABASE_URL=postgresql://ian:ian@localhost:5432/ianrelief

# Polite User-Agent for public APIs (Overpass asks for a contact string).
IAN_HTTP_USER_AGENT=ian-relief-logistics/0.1 (student project; github.com/kingsley-marin/ian-relief-logistics)

# Overpass endpoint. Alternatives: https://overpass.kumi.systems/api/interpreter
IAN_OVERPASS_URL=https://overpass-api.de/api/interpreter
